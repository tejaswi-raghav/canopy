# All NEXT_PUBLIC_* values are embedded in the static bundle: never put secrets here.
NEXT_PUBLIC_BASE_PATH=            # e.g. /canopy-app for GitHub Pages project sites
NEXT_PUBLIC_MAP_STYLE_URL=        # optional vector style (e.g. MapTiler/Stadia); enables 3D buildings
NEXT_PUBLIC_SATELLITE_TILE_URL=   # optional raster XYZ template; enables satellite layer
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_REPORTS_ENDPOINT=     # optional URL of the FastAPI service; otherwise reports stay in this browser

# backend/ (server-side only)
CANOPY_CORS_ORIGINS=http://localhost:3000
CANOPY_DB_PATH=canopy.db
CANOPY_HASH_SALT=change-me
CANOPY_MODERATOR_TOKEN=change-me
